{
  "name": "personal-agent-preview",
  "version": "0.4.0-preview.2",
  "private": true,
  "description": "Plan-backed Personal Agent desktop preview",
  "main": "dist/main.cjs",
  "scripts": {
    "build:memory": "node scripts/build-memory.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "test": "node scripts/test.mjs",
    "check:codex": "node scripts/check-codex.mjs",
    "package": "node scripts/package.mjs",
    "stage:runtime": "node scripts/stage-task-runtime.mjs"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "electron": "44.10.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "esbuild-wasm": "0.25.12",
    "react-test-renderer": "^19.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "local.personalagent.preview",
    "productName": "Personal Agent Preview",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "extraFiles": [
      {
        "from": "scripts/Check-Startup.ps1",
        "to": "Check-Startup.ps1"
      },
      {
        "from": "scripts/CHECK-STARTUP.cmd",
        "to": "CHECK-STARTUP.cmd"
      },
      {
        "from": "WINDOWS-START-HERE.txt",
        "to": "WINDOWS-START-HERE.txt"
      },
      {
        "from": "README.md",
        "to": "READ-ME-FIRST.md"
      }
    ],
    "directories": {
      "output": "../../../work/desktop-preview-release"
    },
    "files": [
      "dist/main.cjs",
      "dist/preload.cjs",
      "dist/renderer.js",
      "dist/renderer.css",
      "dist/index.html",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    },
    "extraResources": [
      {
        "from": "dist/tasks.cjs",
        "to": "task-service/tasks.cjs"
      },
      {
        "from": "dist/memory-service",
        "to": "task-service/memory-service"
      },
      {
        "from": "dist/service-runtime/node.exe",
        "to": "task-service/node.exe"
      },
      {
        "from": "dist/service-runtime/runtime-manifest.json",
        "to": "task-service/runtime-manifest.json"
      }
    ]
  }
}
