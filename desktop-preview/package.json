{
  "name": "personal-agent-preview",
  "version": "0.4.0-preview.2",
  "private": true,
  "description": "Plan-backed Personal Agent desktop preview",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "electron .",
    "test": "node scripts/test.mjs",
    "check:codex": "node scripts/check-codex.mjs",
    "package": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.12",
    "esbuild-wasm": "0.25.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "local.personalagent.preview",
    "productName": "Personal Agent Preview",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "extraFiles": [
      {
        "from": "scripts/Check-Startup.ps1",
        "to": "Check-Startup.ps1"
      },
      {
        "from": "scripts/CHECK-STARTUP.cmd",
        "to": "CHECK-STARTUP.cmd"
      },
      {
        "from": "WINDOWS-START-HERE.txt",
        "to": "WINDOWS-START-HERE.txt"
      },
      {
        "from": "README.md",
        "to": "READ-ME-FIRST.md"
      }
    ],
    "directories": {
      "output": "../../../work/desktop-preview-release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
